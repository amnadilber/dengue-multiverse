# Raw and intermediate data are reproducible from scripts/00_download_data.py.
# The OpenDengue extract alone is ~480 MB, far above GitHub's file size limit.
data/raw/
data/interim/
data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep

# Results are regenerated by the pipeline; keep only what the paper cites.
results/models/
*.ckpt
*.h5
*.keras

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.ipynb_checkpoints/
.pytest_cache/
.coverage

# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.synctex.gz
paper/*.toc
paper/*.fdb_latexmk
paper/*.fls

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Assistant / tooling state — never part of the research record.
.claude/
CLAUDE.md
.cursor/
.aider*
.github/copilot*
